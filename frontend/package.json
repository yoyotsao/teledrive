{
  "name": "tele-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-buffer-polyfill.mjs && node scripts/build-service-worker.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=isolated",
    "test:e2e:ui": "playwright test --project=isolated --ui",
    "test:e2e:headed": "playwright test --project=isolated --headed",
    "test:e2e:debug": "playwright test --project=isolated --debug",
    "test:e2e:report": "playwright show-report",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e:smoke": "node scripts/run-smoke.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "big-integer": "^1.6.52",
    "buffer": "^6.0.3",
    "playwright": "^1.59.1",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.11"
  }
}
