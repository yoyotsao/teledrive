# TeleDrive Configuration
# Copy this file to .env and fill in your values

# Telegram API Credentials (required, embedded in the frontend at build time)
# Get from https://my.telegram.org/apps
# For native development, also put these two variables in frontend/.env.local.
VITE_TELEGRAM_API_ID=your_api_id_here
VITE_TELEGRAM_API_HASH=your_api_hash_here

# Build-time gate for the one-time Saved Messages -> shared channel migration UI.
# Keep disabled for normal deployments after migration is complete.
VITE_ENABLE_STORAGE_MIGRATION=false

# Bot Token (REQUIRED for login)
# Create a bot with @BotFather on Telegram and paste the token here. Login works
# by having the browser DM a one-time nonce to this bot — that's how the backend
# learns who you are without ever receiving your session string.
TELEGRAM_BOT_TOKEN=

# JWT signing secret (required, at least 32 bytes). Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional browser origins allowed to call the metadata API (JSON list).
# CORS_ORIGINS=["https://drive.example.com"]

# Cloudflare tunnel connector token (required — the cloudflared service in
# docker-compose.yml refuses to start without it). Copy it from the Zero Trust
# dashboard: select your tunnel and copy the `--token` value from its connector
# install command. Configure its published hostname to use http://localhost:3000.
CLOUDFLARE_TUNNEL_TOKEN=

# Native development server (Compose fixes these to 0.0.0.0:8000)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
