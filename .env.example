# TeleDrive Configuration
# Copy this file to .env and fill in your values

# Telegram API Credentials (required)
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Same credentials, VITE_-prefixed — required so docker-compose.yml can pass
# them as frontend build args (Vite only exposes VITE_-prefixed env vars to
# client code). Keep these in sync with the values above.
VITE_TELEGRAM_API_ID=your_api_id_here
VITE_TELEGRAM_API_HASH=your_api_hash_here

# Bot Token (REQUIRED for login)
# Create a bot with @BotFather on Telegram and paste the token here. Login works
# by having the browser DM a one-time nonce to this bot — that's how the backend
# learns who you are without ever receiving your session string.
TELEGRAM_BOT_TOKEN=

# Session String (optional — users now log in via browser)
# Only needed if running single-user mode without browser login
TELEGRAM_SESSION_STRING=

# JWT signing secret (optional — auto-generated if not set; set this to keep
# sessions valid across backend restarts)
JWT_SECRET=

# Server (optional, defaults shown)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
